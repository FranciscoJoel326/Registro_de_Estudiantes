@page "/estudiantes/Edit/{EstudianteId:int}"

@inject EstudiantesServices estudiantesService
@inject NavigationManager navigationManager
@rendermode InteractiveServer

<PageTitle>Editar Estudiante</PageTitle>
<EditForm Model="estudiante" OnValidSubmit="Modificar" FormName="Estudiantes">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="container">
        <div class="card shadow-lg">
            <div class=" card-header text-center">
                <h5 class="card-title">Modificar Estudiante</h5>
            </div>
        </div>

        <div class="card-body">

            <div class="mb-3">
                <label class="col-form-label"><strong>Nombres</strong></label>
                <InputText class="form-control" @bind-Value="estudiante.Nombres"></InputText>
                <label class="form-label"><strong>@Mensaje</strong></label>
                <ValidationMessage For="(() => estudiante.Nombres)" />
            </div>

            <div class="mb-3">
                <label class="form-label"><strong>Direccion</strong></label>
                <InputText class="form-control" @bind-Value="estudiante.Direccion"></InputText>
                <ValidationMessage For="(() => estudiante.Direccion)" />
            </div>

            <div class="mb-3">
                <label class="form-label"><strong>Email</strong></label>
                <InputText class="form-control" @bind-Value="estudiante.Email"></InputText>
                <ValidationMessage For="(() => estudiante.Email)" />
            </div>

            <div class="mb-3">
                <label class="form-label"><strong>Fecha de Nacimiento</strong></label>
                <InputDate class="form-control" @bind-Value="estudiante.FechaNacimiento"></InputDate>
                <ValidationMessage For="(() => estudiante.FechaNacimiento)" />
            </div>
        </div>

        <div class="card-footer text-center mt-2">
            <a href="/estudiantes" class="btn btn-secondary">
                <span class="bi bi-arrow-left"></span> Volver
            </a>
            <button type="submit" class="btn btn-primary bi bi-floppy"> Modificar</button>
            <button type="button" class="btn btn-danger bi bi-trash" @onclick="Eliminar"> Eliminar</button>
        </div>
    </div>

</EditForm>
@code {
    [Parameter]
    public int EstudianteId { get; set; }
    public Estudiantes estudiante { get; set; } = new Estudiantes();
    public string Mensaje { get; set; } = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        estudiante = await estudiantesService.Buscar(EstudianteId) ?? new Estudiantes();
    }

    public async Task Modificar()
    {
        var existe = await estudiantesService.Existe(estudiante.EstudianteId, estudiante.Nombres);

        if (existe)
        {
            Mensaje = "Ya existe un estudiante con ese nombre";
            return;
        }

        var modificado = await estudiantesService.Guardar(estudiante);
        if (modificado)
        {
            navigationManager.NavigateTo("/estudiantes");
        }
        else
        {
            Mensaje = "No se pudo modificar el estudiante";
        }
    }

    private async Task Eliminar()
    {
        var eliminado = await estudiantesService.Eliminar(EstudianteId);
        if (eliminado)
        {
            navigationManager.NavigateTo("/estudiantes");
        }
        else
        {
            Mensaje = "No se pudo eliminar el estudiante";
        }
    }
}
