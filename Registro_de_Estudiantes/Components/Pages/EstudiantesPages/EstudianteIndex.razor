@page "/estudiantes"

@inject EstudiantesServices estudiantesService
@inject NavigationManager navigationManager
@rendermode InteractiveServer

<PageTitle>Registro de Estudiantes</PageTitle>
<div class="container">
    <div class="card shadow-lg">
        <div class="card-header space-between">
            <h5 class="card-title">Registro de Estudiantes</h5>
            <a href="/estudiantes/Create" class="btn btn-primary"><span class="bi bi-plus-square mt-1"></span>  Crear</a>
        </div>

        <div class="card-body">

            <div class="row">

                <div class="col-3">
                    <label class="col-form-label"><strong>Filtrar por</strong></label>
                </div>

                <div class="col-4">
                    <label class="col-form-label"><strong>B&uacute;squeda</strong></label>
                </div>
            </div>

            <div class="row align-items-center">
                <div class="col-3">
                    <select class="form-select" @bind="Filtro">
                        <option value="" selected disabled>Seleccione </option>
                        <option value="Nombres">Nombres</option>
                        <option value="Direccion">Direccion</option>
                        <option value="Email">Email</option>
                    </select>
                </div>

                <div class="col-4">
                    <div class="input-group">
                        <input class="form-control" @bind="ValorFiltro" placeholder="Buscar" />
                        <button type="button" class="btn btn-outline-primary bi bi-search" @onclick="Buscar"></button>
                    </div>
                </div>

                <div class="col-2">
                    <button type="button" class="btn btn-outline-primary bi bi-arrow-counterclockwise" @onclick="Restablecer"></button>
                </div>

                <table class="table table-hover">
                    <thead class="table table-striped text-black">
                        <tr>
                            <th>EstudianteId</th>
                            <th>Nombres</th>
                            <th>Direccion</th>
                            <th>Email</th>
                            <th>FechaNacimiento</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var estudiante in ListaEstudiantes)
                        {
                            <tr>
                                <td>@estudiante.EstudianteId</td>
                                <td>@estudiante.Nombres</td>
                                <td>@estudiante.Direccion</td>
                                <td>@estudiante.Email</td>
                                <td>@estudiante.FechaNacimiento.ToString("dd/MM/yyyy")</td>

                                <td class="text-center">
                                    <a href="/estudiantes/Edit/@estudiante.EstudianteId" class="btn btn-outline-primary bi bi-pencil-square"></a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

            </div>

            <div class="card-footer space-between">
                <label>Cantidad: @ListaEstudiantes.Count()</label>
            </div>
        </div>
    </div>
</div>

@code {

    public List<Estudiantes> ListaEstudiantes { get; set; } = new List<Estudiantes>();

    public string Filtro { get; set; } = string.Empty;
    public string ValorFiltro { get; set; } = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        ListaEstudiantes = await estudiantesService.Listar(e => e.EstudianteId > 0);
    }

    private async Task Buscar()
    {
        if (ValorFiltro.Trim() != "")
        {
            if (Filtro == nameof(Estudiantes.Nombres))
            {
                ListaEstudiantes = await estudiantesService.Listar(e => e.Nombres.ToLower().Contains(ValorFiltro.ToLower()));
            }
            else if (Filtro == nameof(Estudiantes.Direccion))
            {
                ListaEstudiantes = await estudiantesService.Listar(e => e.Direccion.ToLower().Contains(ValorFiltro.ToLower()));
            }
            else if (Filtro == nameof(Estudiantes.Email))
            {
                ListaEstudiantes = await estudiantesService.Listar(e => e.Email.ToLower().Contains(ValorFiltro.ToLower()));
            }
        }
    }

    private async Task Restablecer()
    {
        ListaEstudiantes = await estudiantesService.Listar(e => e.EstudianteId > 0);
        Filtro = string.Empty;
        ValorFiltro = string.Empty;
    }

}
