@page "/estudiantes/Create"

@inject EstudiantesServices estudiantesService
@inject NavigationManager navigationManager
@rendermode InteractiveServer

<PageTitle>Create</PageTitle>
<EditForm Model="estudiante" OnValidSubmit="Guardar" FormName="Estudiantes">
    <DataAnnotationsValidator />

    <div class="container">
        <div class="card shadow-lg">
            <div class=" card-header text-center">
                <h5 class="card-title">Crear Estudiante</h5>
            </div>
        </div>

        <div class="card-body">

            <div class="mb-3">
                <label class="col-form-label"><strong>Nombres</strong></label>
                <InputText class="form-control" @bind-Value="estudiante.Nombres"></InputText>
                <label class="form-label"><strong>@Mensaje</strong></label>
                <ValidationMessage For="(() => estudiante.Nombres)" />
            </div>

            <div class="mb-3">
                <label class="form-label"><strong>Direccion</strong></label>
                <InputText class="form-control" @bind-Value="estudiante.Direccion"></InputText>
                <ValidationMessage For="(() => estudiante.Direccion)" />
            </div>

            <div class="mb-3">
                <label class="form-label"><strong>Email</strong></label>
                <InputText class="form-control" @bind-Value="estudiante.Email"></InputText>
                <ValidationMessage For="(() => estudiante.Email)" />
            </div>

            <div class="mb-3">
                <label class="form-label"><strong>Fecha de Nacimiento</strong></label>
                <InputDate class="form-control" @bind-Value="estudiante.FechaNacimiento"></InputDate>
                <ValidationMessage For="(() => estudiante.FechaNacimiento)" />
            </div>
        </div>

        <div class="card-footer text-center mt-2">
            <a href="/estudiantes" class="btn btn-secondary"><span class="bi bi-arrow-left"></span> Volver</a>
            <button type="submit" class="btn btn-primary bi bi-floppy"> Guardar</button>
        </div>

    </div>

</EditForm>

@code {
    public Estudiantes estudiante { get; set; } = new Estudiantes();
    public string Mensaje { get; set; } = string.Empty;

    public async Task Guardar()
    {
        var existe = await estudiantesService.Existe(estudiante.EstudianteId, estudiante.Nombres);

        if (existe)
        {
            Mensaje = "Ya existe un estudiante con ese nombre";
            return;
        }

        var creado = await estudiantesService.Guardar(estudiante);

        if (creado)
        {
            navigationManager.NavigateTo("/estudiantes");
        }
    }
}
